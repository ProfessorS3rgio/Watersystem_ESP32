{
  "identifier": "desktop-serial",
  "description": "USB serial and billing report exports for the local DMBC window only.",
  "windows": ["main"],
  "local": false,
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": ["allow-serial-ports", "allow-serial-connect", "allow-serial-write", "allow-serial-disconnect", "allow-save-billing-report"]
}
