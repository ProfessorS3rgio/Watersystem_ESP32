{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "desktop:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/prepare.ps1",
        "desktop:dev": "npm run desktop:prepare && tauri dev",
        "desktop:build": "npm run desktop:prepare && tauri build",
        "desktop:build:dev": "npm run desktop:prepare && tauri build --debug",
        "desktop:test": "node desktop/smoke.mjs",
        "build": "vite build",
        "dev": "concurrently \"php artisan serve\" \"vite\" --names=\"Laravel,Vite\" --prefix-colors=\"green,blue\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@tauri-apps/cli": "^2.12.4",
        "@vitejs/plugin-vue": "^6.0.3",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.4",
        "vue": "^3.5.26",
        "vue-router": "^4.6.4"
    }
}
